ALFABET = "abcdefghijklmnopqrstuvwxyz"


def cek_sandi(ch, k):
    if ch.lower() in ALFABET:
        posisi = ALFABET.find(ch.lower())

        posisi_baru = (posisi + k) % 26
        hasil = ALFABET[posisi_baru]

        if ch.isupper():
            return hasil.upper()
        else:
            return hasil

    return ch


def mesin_enkripsi(teks, k):
    hasil = ""

    for ch in teks:
        hasil += cek_sandi(ch, k)

    return hasil


def mesin_dekripsi(teks, k):
    return mesin_enkripsi(teks, -k)


def retas_sandi(sandi, kata_kunci):
    hasil = []

    for k in range(26):
        pesan_asli = mesin_dekripsi(sandi, k)

        if pesan_asli.lower().find(kata_kunci.lower()) != -1:
            hasil.append((k, pesan_asli))

    return hasil


sandi = input("Masukan pesan tersita: ")
kata_kunci = input("Masukan kata kunci target: ")

hasil = retas_sandi(sandi, kata_kunci)

print("Output Deskripsi:", hasil)